@page "/"

<div class="max-w-screen-2xl mx-auto space-y-3">
    <div class="text-center space-y-1">
        <h1 class="text-2xl font-bold text-gray-800">Developer Tools</h1>
        <p class="text-sm text-gray-600">All tools in one place.</p>
    </div>

    <section>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
            @foreach (var tool in toolCards)
            {
                <NavLink class="tool-card bg-white border border-gray-200 rounded-lg p-3 hover:shadow-md hover:border-blue-300 transition-all"
                         href="@tool.Route">
                    <div class="flex items-start gap-3">
                        <div class="w-9 h-9 @tool.IconClasses rounded-md flex items-center justify-center shrink-0">
                            @((MarkupString)tool.IconSvg)
                        </div>
                        <div class="min-w-0">
                            <h2 class="text-sm font-semibold text-gray-800 leading-tight">@tool.Title</h2>
                            <p class="text-xs text-gray-600 mt-1 leading-snug">@tool.Description</p>
                        </div>
                    </div>
                </NavLink>
            }
        </div>
    </section>
</div>

