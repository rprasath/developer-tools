@page "/sqlformatter"
@using System.Linq
@using System.Text
@using System.Text.RegularExpressions
@inject IJSRuntime JSRuntime

<div class="max-w-screen-xl mx-auto space-y-4">
    <div>
        <h1 class="text-3xl font-bold text-gray-800">SQL Formatter</h1>
        <p class="text-gray-600 mt-2">
            Full in-place SQL formatting with readable clause layout, indentation, and keyword casing. Paste, format, and copy from the same editor.
        </p>
    </div>

    <section class="bg-white rounded-lg shadow-md overflow-hidden">
        <header class="border-b border-gray-200 px-4 py-3 flex flex-wrap items-center gap-2 justify-between">
            <h2 class="text-lg font-semibold text-gray-800">SQL Editor</h2>
            <div class="flex flex-wrap gap-2">
                <button @onclick="FormatSqlInPlace"
                        class="px-3 py-1.5 bg-blue-600 text-white text-sm font-semibold rounded-md hover:bg-blue-700 transition-colors">
                    Format In Place
                </button>
                <button @onclick="CopyInput"
                        id="sql-formatter-copy"
                        class="px-3 py-1.5 bg-gray-100 text-gray-700 text-sm font-semibold rounded-md hover:bg-gray-200 transition-colors">
                    Copy
                </button>
                <button @onclick="RestoreOriginal"
                        class="px-3 py-1.5 bg-amber-100 text-amber-800 text-sm font-semibold rounded-md hover:bg-amber-200 transition-colors"
                        disabled="@string.IsNullOrEmpty(OriginalSql)">
                    Restore Original
                </button>
                <button @onclick="Reset"
                        class="px-3 py-1.5 bg-gray-200 text-gray-700 text-sm font-semibold rounded-md hover:bg-gray-300 transition-colors">
                    Clear
                </button>
            </div>
        </header>

        <div class="p-4 space-y-3">
            <div class="flex flex-wrap gap-4 text-sm text-gray-700">
                <label class="inline-flex items-center gap-2">
                    <input type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" @bind="UppercaseKeywords" />
                    Uppercase keywords
                </label>
                <label class="inline-flex items-center gap-2">
                    <input type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" @bind="BreakOnCommas" />
                    Break SELECT lists on commas
                </label>
                <label class="inline-flex items-center gap-2">
                    <input type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" @bind="AlignLogicalOperators" />
                    Indent AND/OR in WHERE
                </label>
                <label class="inline-flex items-center gap-2">
                    <input type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" @bind="EnsureTrailingSemicolon" />
                    Ensure trailing semicolon
                </label>
                <label class="inline-flex items-center gap-2">
                    <span class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Indent</span>
                    <input id="indent-size"
                           type="number"
                           min="2"
                           max="8"
                           @bind="IndentSize"
                           class="w-20 border border-gray-300 rounded-md px-2 py-1 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" />
                </label>
            </div>

            <textarea id="sql-input"
                      @bind="InputSql"
                      @bind:event="oninput"
                      @bind:after="OnSqlChanged"
                      class="w-full h-[32rem] p-3 border border-gray-300 rounded-md font-mono text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                      placeholder="SELECT ..."></textarea>

            <p class="text-xs text-gray-500">
                Formatter protects string literals and comments before formatting, then restores them unchanged.
            </p>
        </div>
    </section>
</div>

@code {
    private string InputSql { get; set; } = string.Empty;
    private string OriginalSql { get; set; } = string.Empty;
    private bool UppercaseKeywords { get; set; } = true;
    private bool BreakOnCommas { get; set; } = true;
    private bool AlignLogicalOperators { get; set; } = true;
    private bool EnsureTrailingSemicolon { get; set; }
    private int IndentSize { get; set; } = 4;
    private bool IsApplyingFormat { get; set; }

    private static readonly string[] ClauseBreaks =
    {
        "WITH", "SELECT", "FROM", "WHERE", "GROUP BY", "HAVING", "ORDER BY",
        "INSERT INTO", "VALUES", "UPDATE", "SET", "DELETE FROM", "MERGE", "USING",
        "LEFT JOIN", "RIGHT JOIN", "FULL JOIN", "INNER JOIN", "OUTER JOIN", "CROSS JOIN", "JOIN",
        "ON", "UNION ALL", "UNION", "EXCEPT", "INTERSECT", "WHEN MATCHED", "WHEN NOT MATCHED", "THEN", "ELSE", "END"
    };

    private static readonly string[] KeywordList =
    {
        "select", "from", "where", "group", "by", "having", "order", "insert", "into", "values",
        "update", "set", "delete", "merge", "using", "when", "then", "else", "end", "join", "left", "right",
        "full", "inner", "outer", "cross", "on", "and", "or", "not", "exists", "in", "case", "as", "distinct",
        "top", "with", "nolock", "union", "all", "except", "intersect", "over", "partition", "desc", "asc"
    };

    private async Task CopyInput()
    {
        if (string.IsNullOrWhiteSpace(InputSql))
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync("copyToClipboard", InputSql, "sql-formatter-copy");
    }

    private void Reset()
    {
        InputSql = string.Empty;
        OriginalSql = string.Empty;
    }

    private void RestoreOriginal()
    {
        if (!string.IsNullOrWhiteSpace(OriginalSql))
        {
            IsApplyingFormat = true;
            InputSql = OriginalSql;
            IsApplyingFormat = false;
        }
    }

    private void FormatSqlInPlace()
    {
        if (string.IsNullOrWhiteSpace(InputSql))
        {
            return;
        }

        if (string.IsNullOrEmpty(OriginalSql))
        {
            OriginalSql = InputSql;
        }

        var sourceSql = OriginalSql;
        IsApplyingFormat = true;
        InputSql = FormatSql(sourceSql);
        IsApplyingFormat = false;
    }

    private void OnSqlChanged()
    {
        if (!IsApplyingFormat)
        {
            // User edited content manually; reset baseline so next format uses current editor text.
            OriginalSql = string.Empty;
        }
    }

    private string FormatSql(string sql)
    {
        var working = NormalizeLineEndings(sql).Trim();
        var (maskedSql, tokens) = MaskProtectedSections(working);

        if (UppercaseKeywords)
        {
            maskedSql = ApplyKeywordCasing(maskedSql);
        }

        maskedSql = NormalizeWhitespace(maskedSql);
        maskedSql = InsertClauseBreaks(maskedSql, UppercaseKeywords);

        if (BreakOnCommas)
        {
            maskedSql = BreakSelectLists(maskedSql);
        }

        maskedSql = ApplyIndentation(maskedSql);

        if (EnsureTrailingSemicolon)
        {
            maskedSql = EnsureSemicolon(maskedSql);
        }

        var restored = RestoreProtectedSections(maskedSql, tokens);
        restored = Regex.Replace(restored, @"\n{3,}", "\n\n").Trim();
        return restored;
    }

    private string ApplyIndentation(string sql)
    {
        var lines = sql.Split('\n', StringSplitOptions.RemoveEmptyEntries)
                       .Select(line => line.TrimEnd())
                       .Where(line => !string.IsNullOrWhiteSpace(line))
                       .ToList();

        var builder = new StringBuilder();
        var indentLevel = 0;
        var inWhereBlock = false;

        foreach (var rawLine in lines)
        {
            var line = rawLine.Trim();
            if (line.Length == 0)
            {
                continue;
            }

            if (StartsWithAny(line, "WHERE"))
            {
                inWhereBlock = true;
            }
            else if (StartsWithAny(line, "GROUP BY", "ORDER BY", "HAVING", "UNION", "UNION ALL", "EXCEPT", "INTERSECT"))
            {
                inWhereBlock = false;
            }

            var closingParenCount = line.Count(c => c == ')');
            var openingParenCount = line.Count(c => c == '(');

            if (line.StartsWith(")", StringComparison.Ordinal) ||
                line.StartsWith("END", StringComparison.OrdinalIgnoreCase) ||
                line.StartsWith("ELSE", StringComparison.OrdinalIgnoreCase))
            {
                indentLevel = Math.Max(0, indentLevel - 1);
            }

            if (closingParenCount > openingParenCount && line.StartsWith(")", StringComparison.Ordinal))
            {
                indentLevel = Math.Max(0, indentLevel - (closingParenCount - openingParenCount));
            }

            var lineIndentLevel = indentLevel;
            if (AlignLogicalOperators && inWhereBlock && IsLogicalOperator(line))
            {
                lineIndentLevel = Math.Max(1, indentLevel + 1);
            }

            var indent = new string(' ', Math.Max(0, lineIndentLevel) * IndentSize);
            builder.AppendLine(indent + line);

            if (openingParenCount > closingParenCount)
            {
                indentLevel += openingParenCount - closingParenCount;
            }
            else if (openingParenCount < closingParenCount)
            {
                indentLevel = Math.Max(0, indentLevel - (closingParenCount - openingParenCount));
            }

            if (StartsNewBlock(line))
            {
                indentLevel++;
            }

            if (line.StartsWith("END", StringComparison.OrdinalIgnoreCase))
            {
                indentLevel = Math.Max(0, indentLevel - 1);
            }
        }

        return builder.ToString().TrimEnd();
    }

    private static string EnsureSemicolon(string sql)
    {
        var trimmed = sql.TrimEnd();
        return trimmed.EndsWith(';') ? trimmed : trimmed + ";";
    }

    private static bool StartsNewBlock(string line)
    {
        return StartsWithAny(
            line,
            "SELECT", "FROM", "WHERE", "GROUP BY", "HAVING", "ORDER BY", "VALUES", "SET",
            "INSERT INTO", "UPDATE", "DELETE FROM", "JOIN", "LEFT JOIN", "RIGHT JOIN", "INNER JOIN", "OUTER JOIN", "ON");
    }

    private static bool IsLogicalOperator(string line)
    {
        return line.StartsWith("AND ", StringComparison.OrdinalIgnoreCase) ||
               line.StartsWith("OR ", StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeLineEndings(string value)
    {
        return value.Replace("\r\n", "\n", StringComparison.Ordinal)
                    .Replace('\r', '\n');
    }

    private static string NormalizeWhitespace(string value)
    {
        value = Regex.Replace(value, @"[ \t]+", " ");
        value = Regex.Replace(value, @"\s*\n\s*", "\n");
        return value;
    }

    private static string ApplyKeywordCasing(string sql)
    {
        return KeywordList.Aggregate(sql, (current, keyword) =>
            Regex.Replace(
                current,
                $@"\b{Regex.Escape(keyword)}\b",
                keyword.ToUpperInvariant(),
                RegexOptions.IgnoreCase));
    }

    private static string InsertClauseBreaks(string sql, bool uppercase)
    {
        var orderedClauseBreaks = ClauseBreaks.OrderByDescending(c => c.Length);
        foreach (var clause in orderedClauseBreaks)
        {
            sql = Regex.Replace(
                sql,
                $@"\s*{Regex.Escape(clause)}\b",
                match =>
                {
                    var token = match.Value.Trim();
                    return "\n" + (uppercase ? clause : token);
                },
                RegexOptions.IgnoreCase);
        }

        sql = Regex.Replace(sql, @"\n{2,}", "\n");
        sql = sql.TrimStart('\n');
        return sql;
    }

    private static string BreakSelectLists(string sql)
    {
        var lines = sql.Split('\n').ToList();
        var result = new List<string>();

        for (var i = 0; i < lines.Count; i++)
        {
            var line = lines[i].Trim();
            if (!line.StartsWith("SELECT", StringComparison.OrdinalIgnoreCase))
            {
                result.Add(lines[i]);
                continue;
            }

            var selectText = line[6..].Trim();
            if (!selectText.Contains(','))
            {
                result.Add(lines[i]);
                continue;
            }

            var columns = selectText.Split(',')
                .Select(c => c.Trim())
                .Where(c => c.Length > 0)
                .ToList();

            if (columns.Count == 0)
            {
                result.Add(lines[i]);
                continue;
            }

            result.Add("SELECT " + columns[0]);
            for (var col = 1; col < columns.Count; col++)
            {
                result.Add(", " + columns[col]);
            }
        }

        return string.Join("\n", result);
    }

    private static (string MaskedSql, Dictionary<string, string> Tokens) MaskProtectedSections(string sql)
    {
        var tokens = new Dictionary<string, string>();
        var builder = new StringBuilder();
        var i = 0;
        var tokenIndex = 0;

        while (i < sql.Length)
        {
            if (i + 1 < sql.Length && sql[i] == '-' && sql[i + 1] == '-')
            {
                var start = i;
                i += 2;
                while (i < sql.Length && sql[i] != '\n')
                {
                    i++;
                }

                AddToken(sql[start..i]);
                continue;
            }

            if (i + 1 < sql.Length && sql[i] == '/' && sql[i + 1] == '*')
            {
                var start = i;
                i += 2;
                while (i + 1 < sql.Length && !(sql[i] == '*' && sql[i + 1] == '/'))
                {
                    i++;
                }

                if (i + 1 < sql.Length)
                {
                    i += 2;
                }

                AddToken(sql[start..i]);
                continue;
            }

            if (sql[i] == '\'' || sql[i] == '"' || sql[i] == '[' || sql[i] == '`')
            {
                var start = i;
                var opener = sql[i];
                var closer = opener == '[' ? ']' : opener;
                i++;

                while (i < sql.Length)
                {
                    if (sql[i] == closer)
                    {
                        if ((opener == '\'' || opener == '"') && i + 1 < sql.Length && sql[i + 1] == closer)
                        {
                            i += 2;
                            continue;
                        }

                        if (opener == '[' && i + 1 < sql.Length && sql[i + 1] == ']')
                        {
                            i += 2;
                            continue;
                        }

                        i++;
                        break;
                    }

                    i++;
                }

                AddToken(sql[start..i]);
                continue;
            }

            builder.Append(sql[i]);
            i++;
        }

        return (builder.ToString(), tokens);

        void AddToken(string tokenValue)
        {
            var tokenKey = $"__SQLTOKEN{tokenIndex}__";
            tokenIndex++;
            tokens[tokenKey] = tokenValue;
            builder.Append(tokenKey);
        }
    }

    private static string RestoreProtectedSections(string sql, Dictionary<string, string> tokens)
    {
        var restored = sql;
        foreach (var token in tokens)
        {
            restored = restored.Replace(token.Key, token.Value, StringComparison.Ordinal);
        }

        return restored;
    }

    private static bool StartsWithAny(string line, params string[] candidates)
    {
        return candidates.Any(candidate => line.StartsWith(candidate, StringComparison.OrdinalIgnoreCase));
    }
}
