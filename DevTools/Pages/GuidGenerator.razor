@page "/guidhelpers"
@using System.Globalization
@inject IJSRuntime JSRuntime

<div class="max-w-screen-2xl mx-auto space-y-2">
    <div>
        <h1 class="text-xl font-bold text-gray-800">GUID Helpers</h1>
        <p class="text-xs text-gray-600 mt-1">Three quick tools for GUID generation and numeric conversion.</p>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-3">
        <section class="bg-white rounded-lg shadow-md p-3 space-y-2">
            <div class="flex items-center justify-between gap-2">
                <h2 class="text-sm font-semibold text-gray-800">1) New GUID</h2>
                <button @onclick="GenerateGuid"
                        class="px-2.5 py-1 text-xs bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                    New
                </button>
            </div>
            <div class="relative">
                <textarea class="w-full p-2 border border-gray-300 rounded-md bg-gray-50 font-mono text-xs"
                          rows="2"
                          readonly>@NewGuidValue</textarea>
                <button @onclick="CopyNewGuid"
                        id="copy-guid-btn"
                        class="absolute right-2 top-2 text-gray-500 hover:text-gray-700"
                        title="Copy GUID">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                </button>
            </div>
        </section>

        <section class="bg-white rounded-lg shadow-md p-3 space-y-2">
            <h2 class="text-sm font-semibold text-gray-800">2) Long + Int to GUID</h2>
            <div class="grid grid-cols-1 gap-2">
                <div>
                    <label for="long-input" class="block text-[11px] font-semibold text-gray-600 uppercase mb-1">Long</label>
                    <input id="long-input"
                           type="text"
                           @bind="LongInput"
                           class="w-full border border-gray-300 rounded-md px-2 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="decimal or 0x..." />
                </div>
                <div>
                    <label for="int-input" class="block text-[11px] font-semibold text-gray-600 uppercase mb-1">Int</label>
                    <input id="int-input"
                           type="text"
                           @bind="IntInput"
                           class="w-full border border-gray-300 rounded-md px-2 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="decimal or 0x..." />
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <select id="byte-order"
                            @bind="SelectedByteOrder"
                            class="w-full border border-gray-300 rounded-md px-2 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        <option value="@GuidByteOrder.LittleEndian">Little endian</option>
                        <option value="@GuidByteOrder.BigEndian">Big endian</option>
                    </select>
                    <button @onclick="ConvertLongIntToGuid"
                            class="w-full px-2 py-1.5 text-xs bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                        Convert
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(LongIntError))
            {
                <div class="rounded-md bg-red-50 border border-red-200 text-red-700 text-xs px-2 py-1.5">@LongIntError</div>
            }

            @if (!string.IsNullOrWhiteSpace(LongIntToGuidOutput))
            {
                <div class="relative">
                    <textarea class="w-full p-2 border border-gray-300 rounded-md bg-gray-50 font-mono text-xs"
                              rows="2"
                              readonly>@LongIntToGuidOutput</textarea>
                    <button @onclick="CopyLongIntGuid"
                            id="copy-longint-guid-btn"
                            class="absolute right-2 top-2 text-gray-500 hover:text-gray-700"
                            title="Copy GUID">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                    </button>
                </div>
            }
        </section>

        <section class="bg-white rounded-lg shadow-md p-3 space-y-2">
            <h2 class="text-sm font-semibold text-gray-800">3) GUID to Long + Int</h2>
            <div class="grid grid-cols-1 gap-2">
                <input id="guid-input"
                       type="text"
                       @bind="GuidInput"
                       class="w-full border border-gray-300 rounded-md px-2 py-1.5 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                       placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
                <button @onclick="ConvertGuidToLongInt"
                        class="w-full px-2 py-1.5 text-xs bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                    Convert
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(GuidToNumbersError))
            {
                <div class="rounded-md bg-red-50 border border-red-200 text-red-700 text-xs px-2 py-1.5">@GuidToNumbersError</div>
            }

            @if (!string.IsNullOrWhiteSpace(GuidToLongOutput))
            {
                <div class="grid grid-cols-2 gap-2">
                    <div class="relative">
                        <label class="block text-[11px] font-semibold text-gray-600 uppercase mb-1">Long</label>
                        <textarea class="w-full p-2 border border-gray-300 rounded-md bg-gray-50 font-mono text-xs"
                                  rows="2"
                                  readonly>@GuidToLongOutput</textarea>
                        <button @onclick="CopyGuidLong"
                                id="copy-guid-long-btn"
                                class="absolute right-2 top-6 text-gray-500 hover:text-gray-700"
                                title="Copy long">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                        </button>
                    </div>
                    <div class="relative">
                        <label class="block text-[11px] font-semibold text-gray-600 uppercase mb-1">Int</label>
                        <textarea class="w-full p-2 border border-gray-300 rounded-md bg-gray-50 font-mono text-xs"
                                  rows="2"
                                  readonly>@GuidToIntOutput</textarea>
                        <button @onclick="CopyGuidInt"
                                id="copy-guid-int-btn"
                                class="absolute right-2 top-6 text-gray-500 hover:text-gray-700"
                                title="Copy int">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private string NewGuidValue { get; set; } = string.Empty;

    private string? LongInput { get; set; }
    private string? IntInput { get; set; }
    private GuidByteOrder SelectedByteOrder { get; set; } = GuidByteOrder.LittleEndian;
    private string? LongIntToGuidOutput { get; set; }
    private string? LongIntError { get; set; }

    private string? GuidInput { get; set; }
    private string? GuidToLongOutput { get; set; }
    private string? GuidToIntOutput { get; set; }
    private string? GuidToNumbersError { get; set; }

    protected override void OnInitialized()
    {
        GenerateGuid();
    }

    private void GenerateGuid()
    {
        NewGuidValue = Guid.NewGuid().ToString("D").ToUpperInvariant();
    }

    private void ConvertLongIntToGuid()
    {
        LongIntError = null;
        LongIntToGuidOutput = null;

        if (!TryParseInt64(LongInput, out var parsedLong) || !TryParseInt32(IntInput, out var parsedInt))
        {
            LongIntError = "Enter valid decimal or 0x-prefixed values for both Long and Int.";
            return;
        }

        var bytes = new byte[16];
        var longBytes = BitConverter.GetBytes(parsedLong);
        var intBytes = BitConverter.GetBytes(parsedInt);

        if (SelectedByteOrder == GuidByteOrder.BigEndian)
        {
            Array.Reverse(longBytes);
            Array.Reverse(intBytes);
        }

        Array.Copy(longBytes, 0, bytes, 0, longBytes.Length);
        Array.Copy(intBytes, 0, bytes, 12, intBytes.Length);

        LongIntToGuidOutput = new Guid(bytes).ToString("D").ToUpperInvariant();
    }

    private void ConvertGuidToLongInt()
    {
        GuidToNumbersError = null;
        GuidToLongOutput = null;
        GuidToIntOutput = null;

        if (string.IsNullOrWhiteSpace(GuidInput) || !Guid.TryParse(GuidInput.Trim(), out var guid))
        {
            GuidToNumbersError = "Enter a valid GUID.";
            return;
        }

        var bytes = guid.ToByteArray();
        GuidToLongOutput = BitConverter.ToInt64(bytes, 0).ToString(CultureInfo.InvariantCulture);
        GuidToIntOutput = BitConverter.ToInt32(bytes, 12).ToString(CultureInfo.InvariantCulture);
    }

    private static bool TryParseInt64(string? input, out long value)
    {
        value = 0;
        if (string.IsNullOrWhiteSpace(input))
        {
            return false;
        }

        var trimmed = input.Trim();
        if (trimmed.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
        {
            return long.TryParse(trimmed[2..], NumberStyles.AllowHexSpecifier, CultureInfo.InvariantCulture, out value);
        }

        return long.TryParse(trimmed, NumberStyles.Integer, CultureInfo.InvariantCulture, out value);
    }

    private static bool TryParseInt32(string? input, out int value)
    {
        value = 0;
        if (string.IsNullOrWhiteSpace(input))
        {
            return false;
        }

        var trimmed = input.Trim();
        if (trimmed.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
        {
            return int.TryParse(trimmed[2..], NumberStyles.AllowHexSpecifier, CultureInfo.InvariantCulture, out value);
        }

        return int.TryParse(trimmed, NumberStyles.Integer, CultureInfo.InvariantCulture, out value);
    }

    private async Task CopyNewGuid()
    {
        if (!string.IsNullOrWhiteSpace(NewGuidValue))
        {
            await JSRuntime.InvokeVoidAsync("copyToClipboard", NewGuidValue, "copy-guid-btn");
        }
    }

    private async Task CopyLongIntGuid()
    {
        if (!string.IsNullOrWhiteSpace(LongIntToGuidOutput))
        {
            await JSRuntime.InvokeVoidAsync("copyToClipboard", LongIntToGuidOutput, "copy-longint-guid-btn");
        }
    }

    private async Task CopyGuidLong()
    {
        if (!string.IsNullOrWhiteSpace(GuidToLongOutput))
        {
            await JSRuntime.InvokeVoidAsync("copyToClipboard", GuidToLongOutput, "copy-guid-long-btn");
        }
    }

    private async Task CopyGuidInt()
    {
        if (!string.IsNullOrWhiteSpace(GuidToIntOutput))
        {
            await JSRuntime.InvokeVoidAsync("copyToClipboard", GuidToIntOutput, "copy-guid-int-btn");
        }
    }

    private enum GuidByteOrder
    {
        LittleEndian,
        BigEndian
    }
}
